OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.4-mini
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
BENDALABS_LEADS_URL=
BENDALABS_LEADS_KEY=
GOOGLE_ADS_CONVERSION_SEND_TO=AW-XXXXXXXXXX/your_conversion_label
ADMIN_LEADS_PASSWORD=change_me
LEAD_TRACKING_HASH_SALT=replace_with_random_secret
RESEND_API_KEY=your_resend_api_key
AUDIT_ALERT_EMAIL_FROM=Audit Bot <alerts@your-domain.com>
AUDIT_ALERT_EMAIL_TO=hello@bendalabs.sk

# LeadPilot reuses the existing server-side OPENAI_API_KEY.
# Two daily discovery slots (06:00, 13:30 Europe/Bratislava), at most 6 analyses each.
LEADPILOT_MODEL=gpt-5.4-mini
LEADPILOT_HOURLY_RATE=35
# Activate only after configuring and verifying the production scheduler.
LEADPILOT_SCHEDULE_ENABLED=false
CRON_SECRET=

# SI For Me /life reuses the existing owner password and BendaLabs bridge.
# Optional independent owner password (server-only):
# LIFE_PASSWORD=
# Optional Life bridge URL; otherwise derived from BENDALABS_LEADS_URL:
# LIFE_STORAGE_URL=
# Optional model override; otherwise OPENAI_MODEL is used:
# LIFE_AI_MODEL=gpt-5.4-mini
# Optional exact additional deployment origin:
# LIFE_ALLOWED_ORIGIN=
